# Local-only project customizations
local/
.local/
.test/

# Claude Code local settings (user-specific, not shared)
.claude/

# Gemini CLI local state/temp files
.gemini/

# OMC / OMX runtime state (local-only, regenerable)
.omc/
.omx/

# Codex / OMX project surfaces (local-only, not shared via this repo)

# Gemini CLI integration metadata (local-only)
GEMINI.md

# Graphify output (regenerable analysis artifacts, any depth)
graphify-out/

# Telemetry — events are local dogfooding data; config/scripts stay tracked.
telemetry/events/
telemetry/*.local.json

# Serena IDE context provider
.serena/

# Conductor local config
.conductor/

# Vault bridge local path pointers (personal machine paths, not shared)
.vault-link
.vault-link.local

# Vault bridge session handoff scratch (ephemeral resume.md, consumed on next SessionStart)
.claude-kit/

# Sensitive or temporary documents (docs/ is now tracked by default)
# Add specific files here if needed, e.g.:
.antrophics_official_skills/
.anthropics_official_skills/
docs/private/

# Python bytecode (generated when scripts are imported, e.g. during local testing)
__pycache__/
*.pyc
.pytest_cache/
.mypy_cache/
.ruff_cache/
.venv/
venv/
.codex/*
!.codex/agents/
!.codex/agents/**
