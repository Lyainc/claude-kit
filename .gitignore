# docs/ is tracked by default. Exceptions below.
docs/private/

# Skill working-draft output — GitHub issues are the canonical decision record,
# so these trails stay local. Written by expert-panel (discussions/),
# adversarial-review, and unknown-discovery (discovery/), so they keep reappearing.
docs/discussions/
docs/adversarial-review/
docs/discovery/

