# OS metadata
.DS_Store
.AppleDouble
.LSOverride
._*

# Editor / IDE
*.swp
*.swo
*~
.idea/
.vscode/
*.sublime-project
*.sublime-workspace

# Backup files
*.bak
*.backup
*.orig

# Logs and temporary files
*.log
*.tmp
*.temp

# Local-only project customizations
local/
.local/
.test/

# Claude Code local settings (user-specific, not shared)
.claude/

# Gemini CLI local state/temp files
.gemini/

# OMX runtime state (local-only, regenerable)
.omx/

# Codex / OMX project surfaces (local-only, not shared via this repo)

# Gemini CLI integration metadata (local-only)
GEMINI.md

# Graphify output (regenerable analysis artifacts, any depth)
graphify-out/

# Telemetry — feedback-loop events are local dogfooding data (user-writable dir).
# The events output path is ${CLAUDE_KIT_TELEMETRY_DIR:-${CLAUDE_PROJECT_ROOT}/.claude-kit/telemetry/events}
# which already falls under the .claude-kit/ ignore below; config/scripts stay tracked.

# Serena IDE context provider
.serena/

# Conductor local config
.conductor/

# Vault bridge local path pointers (personal machine paths, not shared)
.vault-link
.vault-link.local

# Local-only .claude-kit/ scratch: vault-bridge resume.md (ephemeral handoff) +
# feedback-loop telemetry events (.claude-kit/telemetry/events/, opt-in dogfooding data).
.claude-kit/

# Sensitive or temporary documents (docs/ is now tracked by default)
# Add specific files here if needed, e.g.:
.antrophics_official_skills/
.anthropics_official_skills/
docs/private/

# Decision/discussion trails are NOT committed — GitHub issues are the canonical
# decision record (handoff + backlog + task list). These dirs are local working
# material; provenance pointers in issues mark them "(local, untracked)".
# NOTE: ~104 files already tracked under these dirs are a legacy bulk-import
# (commit abc4f36, 2026-06-05); kept for history (no rewrite), no new files added.
# Carve-outs that DO get committed: docs/design/ (living contracts), docs/plans/
# (master plans), docs/specs/ (spec-first Seeds — refine re-input artifacts).
docs/discussions/
docs/adversarial-review/

# Python bytecode (generated when scripts are imported, e.g. during local testing)
__pycache__/
*.pyc
.pytest_cache/
.mypy_cache/
.ruff_cache/
.venv/
venv/
.codex/*
!.codex/agents/
!.codex/agents/**
!.codex/skills/
!.codex/skills/**
.codex/skills/.system/**
!.codex/prompts/
!.codex/prompts/**
