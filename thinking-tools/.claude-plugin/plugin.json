{
  "name": "thinking-tools",
  "version": "4.4.0",
  "description": "Claude Code thinking-tools plugin: 9 skills for structured reasoning, debate, document polish, blind-spot detection, idea crystallization, issue authoring, and next-session completion conditions, plus a thinking-facilitator agent.",
  "author": {
    "name": "Lyainc",
    "url": "https://github.com/Lyainc"
  },
  "homepage": "https://github.com/Lyainc/claude-kit",
  "repository": "https://github.com/Lyainc/claude-kit",
  "license": "MIT",
  "keywords": [
    "skills",
    "thinking",
    "expert-panel",
    "doc-concretize",
    "doc-polish",
    "diverse-sampling",
    "unknown-discovery",
    "thinking-facilitator",
    "adversarial-review",
    "build-spec",
    "completion-condition",
    "issue-authoring"
  ],
  "hooks": {
    "SessionStart": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}\"/hooks/session-start-welcome.sh",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
